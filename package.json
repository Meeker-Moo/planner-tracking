{
  "name": "annual-work-planning",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --configuration development",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "api": "node -e \"require('fs').mkdirSync('dist/annual-work-planning/browser',{recursive:true})\" && wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply moph-planner-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply moph-planner-db --remote",
    "db:seed:local": "wrangler d1 execute moph-planner-db --local --file server/seed-dev.sql",
    "create-super-admin": "node scripts/create-super-admin.mjs",
    "test:server": "tsc -p tsconfig.server.json && vitest run --config vitest.server.config.ts"
  },
  "private": true,
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "exceljs": "^4.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@angular/build": "^22.1.2",
    "@angular/cli": "^22.1.2",
    "@angular/compiler-cli": "^22.1.0",
    "@cloudflare/workers-types": "^5.20261006.1",
    "@tailwindcss/postcss": "^4.3.3",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.28",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8",
    "wrangler": "^4.147.0"
  }
}
